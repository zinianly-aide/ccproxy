<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lanai.proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>__REPO_ROOT__/packages/proxy/dist/index.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LANAI_API_KEY</key>
    <string>__LANAI_API_KEY__</string>
    <key>LAN_ALLOW_CIDRS</key>
    <string>__LAN_ALLOW_CIDRS__</string>
    <key>REPO_ROOT</key>
    <string>__REPO_ROOT__</string>
    <key>PROXY_HOST</key>
    <string>__PROXY_HOST__</string>
    <key>PROXY_PORT</key>
    <string>__PROXY_PORT__</string>
    <key>MODELS_CONFIG</key>
    <string>__MODELS_CONFIG__</string>
    <key>RATE_LIMIT_PER_MIN</key>
    <string>__RATE_LIMIT_PER_MIN__</string>
    <key>CORS_ALLOW_ORIGINS</key>
    <string>__CORS_ALLOW_ORIGINS__</string>
    <key>OLLAMA_URL</key>
    <string>__OLLAMA_URL__</string>
    <key>GEMINI_BIN</key>
    <string>__GEMINI_BIN__</string>
    <key>GEMINI_ARGS</key>
    <string>__GEMINI_ARGS__</string>
    <key>CODEX_PROVIDER</key>
    <string>__CODEX_PROVIDER__</string>
    <key>CODEX_BIN</key>
    <string>__CODEX_BIN__</string>
    <key>CODEX_ARGS</key>
    <string>__CODEX_ARGS__</string>
    <key>CODEX_API_KEY</key>
    <string>__CODEX_API_KEY__</string>
    <key>CODEX_BASE_URL</key>
    <string>__CODEX_BASE_URL__</string>
    <key>CODEX_CWD</key>
    <string>__CODEX_CWD__</string>
    <key>CODEX_SANDBOX</key>
    <string>__CODEX_SANDBOX__</string>
    <key>CODEX_FULL_AUTO</key>
    <string>__CODEX_FULL_AUTO__</string>
    <key>CODEX_ALLOW_SEARCH</key>
    <string>__CODEX_ALLOW_SEARCH__</string>
    <key>LOG_LEVEL</key>
    <string>__LOG_LEVEL__</string>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/lanai/proxy.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/lanai/proxy.err.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
